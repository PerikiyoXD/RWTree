<Window x:Class="RWTree.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RWTree"
        xmlns:converters="clr-namespace:RWTree.Presentation.Converters"
        xmlns:viewModels="clr-namespace:RWTree.Presentation.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance viewModels:MainWindowViewModel}"
        Title="RWTree - RenderWare DFF Explorer" Height="700" Width="1100"
        MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="#1e1e1e"
        FontFamily="Segoe UI" FontSize="14"
        AllowDrop="True"
        Drop="Window_Drop"
        DragOver="Window_DragOver">
    <Window.Resources>
        <!-- Boolean to Visibility Converter -->
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <!-- Null to Visibility Converter -->
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
        <!-- Inverted Boolean to Visibility Converter -->
        <converters:InvertedBooleanToVisibilityConverter x:Key="InvertedBooleanToVisibilityConverter" />

        <!-- Modern Button Style -->
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="#2d89ef" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Margin" Value="4,2" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1e6cc2" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#1a5ea0" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#666" />
                                <Setter Property="Foreground" Value="#999" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern TreeView Style -->
        <Style TargetType="TreeView">
            <Setter Property="Background" Value="#232323" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#444" />
            <Setter Property="Foreground" Value="White" />
        </Style>          <!-- TreeViewItem Style for Modern Look -->
        <Style TargetType="TreeViewItem">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Margin" Value="1" />
            <Setter Property="Padding" Value="4,2" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TreeViewItem">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Border x:Name="Bd"
                                    Grid.Row="0"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="#444"
                                    BorderThickness="0"
                                    CornerRadius="3"
                                    Padding="{TemplateBinding Padding}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <ToggleButton x:Name="Expander"
                                                  Grid.Column="0"
                                                  Background="Transparent"
                                                  BorderThickness="0"
                                                  Width="16"
                                                  Height="16"
                                                  Margin="0,0,4,0"
                                                  IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"
                                                  ClickMode="Press">
                                        <ToggleButton.Style>
                                            <Style TargetType="ToggleButton">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="ToggleButton">
                                                            <Grid Background="Transparent">
                                                                <Path x:Name="ExpandPath"
                                                                      HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"
                                                                      Margin="1,1,1,1"
                                                                      Fill="White"
                                                                      Data="M 4 0 L 8 4 L 4 8 Z" />
                                                            </Grid>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsChecked" Value="True">
                                                                    <Setter TargetName="ExpandPath" Property="Data"
                                                                            Value="M 0 4 L 8 4 L 4 8 Z" />
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </ToggleButton.Style>
                                    </ToggleButton>

                                    <ContentPresenter x:Name="PART_Header"
                                                      Grid.Column="1"
                                                      ContentSource="Header"
                                                      HorizontalAlignment="Left" />
                                </Grid>
                            </Border>

                            <ItemsPresenter x:Name="ItemsHost"
                                            Grid.Row="1"
                                            Margin="19,0,0,0" />
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="False">
                                <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="Expander" Property="Visibility" Value="Hidden" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2d89ef" />
                                <Setter Property="Foreground" Value="White" />
                                <Setter Property="FontWeight" Value="Bold" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3a3a3a" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ScrollBar Styles for Dark Theme -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="#2b2b2b" />
            <Setter Property="Foreground" Value="#666" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="18" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Top Toolbar -->
        <Border Grid.Row="0" Background="#232323" BorderBrush="#444" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Margin="16,8">
                <Button Content="📁 Open DFF..."
                        Command="{Binding OpenFileCommand}"
                        Style="{StaticResource ModernButton}" />
                <Button Content="🗑️ Close File"
                        Command="{Binding CloseFileCommand}"
                        Style="{StaticResource ModernButton}"
                        IsEnabled="{Binding HasDocument}" />
                <Separator Background="#444" Margin="8,4" Width="1" />
                <Button Content="❌ Exit"
                        Command="{Binding ExitCommand}"
                        Style="{StaticResource ModernButton}" />
            </StackPanel>
        </Border>

        <!-- Main Content Area -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="350" MinWidth="200" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="*" MinWidth="300" />
            </Grid.ColumnDefinitions>

            <!-- Left Panel: TreeView -->
            <Border Grid.Column="0" Background="#232323" BorderBrush="#444" BorderThickness="0,0,1,0">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock Text="📊 DFF Structure"
                                   Foreground="#2d89ef"
                                   FontWeight="Bold"
                                   FontSize="16" />
                        <TextBlock Text="{Binding DocumentName}"
                                   Foreground="#ccc"
                                   FontSize="12"
                                   Margin="0,4,0,0"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Border Grid.Row="1"
                            Background="#1a1a1a"
                            BorderBrush="#444"
                            BorderThickness="1"
                            CornerRadius="6">
                        <!-- TreeView with empty state handling -->
                        <Grid>
                            <TreeView x:Name="NodeTree"
                                      ItemsSource="{Binding ChunkNodes}"
                                      SelectedItemChanged="NodeTree_SelectedItemChanged"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      Foreground="White"
                                      FontSize="13"
                                      Margin="8"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                      Visibility="{Binding HasDocument, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TreeView.ItemTemplate>
                                    <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                            <TextBlock Text=" (" Foreground="#888" Margin="4,0,0,0" />
                                            <TextBlock Text="{Binding ChunkType}" Foreground="#2d89ef" />
                                            <TextBlock Text=")" Foreground="#888" />
                                        </StackPanel>
                                    </HierarchicalDataTemplate>
                                </TreeView.ItemTemplate>
                            </TreeView>
                            <!-- Empty state message -->
                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Visibility="{Binding HasDocument, Converter={StaticResource InvertedBooleanToVisibilityConverter}}">
                                <TextBlock Text="📁"
                                           FontSize="48"
                                           HorizontalAlignment="Center"
                                           Margin="0,0,0,16"
                                           Foreground="#666" />
                                <TextBlock Text="No DFF file loaded"
                                           FontSize="16"
                                           Foreground="#888"
                                           HorizontalAlignment="Center"
                                           Margin="0,0,0,8" />
                                <TextBlock Text="Click 'Open DFF...' or drag &amp; drop a .dff file here"
                                           FontSize="14"
                                           Foreground="#666"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
            <!-- Splitter -->
            <GridSplitter Grid.Column="1"
                          Background="#444"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Cursor="SizeWE"
                          ShowsPreview="True">
                <GridSplitter.Template>
                    <ControlTemplate TargetType="GridSplitter">
                        <Border Background="#444" CornerRadius="2">
                            <Rectangle Fill="#666" Width="2" HorizontalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </GridSplitter.Template>
            </GridSplitter>

            <!-- Right Panel: Details -->
            <Border Grid.Column="2" Background="#1e1e1e">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock Text="🔍 Chunk Details"
                                   Foreground="#2d89ef"
                                   FontWeight="Bold"
                                   FontSize="16" />
                        <TextBlock Text="{Binding SelectedChunkNode.ChunkType}"
                                   Foreground="#ccc"
                                   FontSize="12"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                    <Border Grid.Row="1"
                            Background="#232323"
                            BorderBrush="#444"
                            BorderThickness="1"
                            CornerRadius="6">
                        <Grid>                            <!-- Details TextBox -->
                            <TextBox x:Name="txtNode"
                                     Text="{Binding SelectedChunkNode.Details, Mode=OneWay}"
                                     IsReadOnly="True"
                                     Background="Transparent"
                                     Foreground="White"
                                     BorderThickness="0"
                                     FontFamily="Consolas"
                                     FontSize="13"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     VerticalAlignment="Stretch"
                                     HorizontalAlignment="Stretch"
                                     Margin="12"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Auto"
                                     Visibility="{Binding SelectedChunkNode, Converter={StaticResource NullToVisibilityConverter}}" />

                            <!-- Empty details state -->
                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Visibility="{Binding SelectedChunkNode, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Inverted}">
                                <TextBlock Text="🔍"
                                           FontSize="48"
                                           HorizontalAlignment="Center"
                                           Margin="0,0,0,16"
                                           Foreground="#666" />
                                <TextBlock Text="No chunk selected"
                                           FontSize="16"
                                           Foreground="#888"
                                           HorizontalAlignment="Center"
                                           Margin="0,0,0,8" />
                                <TextBlock Text="Select a chunk from the tree to view details"
                                           FontSize="14"
                                           Foreground="#666"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="2" Background="#232323" BorderBrush="#444" BorderThickness="0,1,0,0">
            <Grid Height="28" Margin="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="{Binding StatusMessage}"
                           Foreground="White"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="1"
                           Text="RWTree v1.0 - RenderWare DFF Explorer"
                           Foreground="#888"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>